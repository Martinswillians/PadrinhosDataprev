rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    // Administrador principal
    function superAdmin() {
      return signed()
        && request.auth.token.email == 'willbrasilia@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Administrador cadastrado na coleção "admins" (id = e-mail em minúsculas)
    function adminDoc() {
      return signed() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    function isStaff() { return superAdmin() || adminDoc(); }
    function can(p) {
      return superAdmin() || (adminDoc()
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.perms.get(p, false) == true);
    }
    function isServidor() {
      return signed() && exists(/databases/$(database)/documents/servidores/$(request.auth.uid));
    }

    // Configuração da campanha (campanha), resumo público de arrecadação (resumo) e prestação de contas (prestacao)
    match /config/{d} {
      allow read: if true;
      allow write: if can('campanha') || (d in ['resumo','prestacao'] && can('contribuicoes'));
    }

    // Administradores e permissões (apenas o administrador principal gerencia)
    match /admins/{email} {
      allow get: if superAdmin() || (signed() && request.auth.token.email == email);
      allow list, create, delete: if superAdmin();
      // cada administrador edita o próprio perfil (nunca as permissões)
      allow update: if superAdmin() || (signed() && request.auth.token.email == email
        && request.auth.token.email_verified == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','area','lotacao','fone','foto','descricao']));
    }

    // Colegas terceirizados que serão presenteados (perfil público, sem e-mail)
    match /apadrinhados/{id} {
      allow read: if true;
      allow create, update, delete: if can('terceirizados');
    }
    // E-mail dos terceirizados: somente administradores autorizados
    match /apadrinhados_privado/{id} {
      allow read, write: if can('terceirizados');
    }

    // Contribuições: cada PIX enviado é um documento (um servidor pode fazer vários)
    match /contribuicoes/{id} {
      allow read: if isStaff() || (signed() && resource.data.servidorId == request.auth.uid);
      allow create: if can('contribuicoes') || (isServidor()
        && request.resource.data.servidorId == request.auth.uid
        && request.resource.data.status == 'em_analise'
        && request.resource.data.valor is number
        && request.resource.data.valor > 0 && request.resource.data.valor <= 100000);
      allow update: if can('contribuicoes') || (signed() && resource.data.servidorId == request.auth.uid && (
        // reenvio do comprovante (nunca depois de confirmada)
        ( resource.data.status != 'confirmado'
          && request.resource.data.status == 'em_analise'
          && request.resource.data.valor is number
          && request.resource.data.valor > 0 && request.resource.data.valor <= 100000
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['valor','status','comprovanteNome','enviadoEm','obsAdmin']) )
        ||
        // atualização dos dados do servidor (nome, área, lotação)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['servidorNome','area','lotacao'])
      ));
      allow delete: if can('contribuicoes');
    }

    // Arquivo do comprovante (imagem reduzida ou PDF pequeno, guardado como texto)
    match /comprovantes/{id} {
      allow read: if can('contribuicoes') || (signed() && resource.data.servidorId == request.auth.uid);
      allow create, update: if can('contribuicoes') || (isServidor()
        && request.resource.data.servidorId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/contribuicoes/$(id))
        && getAfter(/databases/$(database)/documents/contribuicoes/$(id)).data.servidorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['servidorId','ano','dados','tipo','nome','enviadoEm'])
        && request.resource.data.dados is string && request.resource.data.dados.size() <= 900000
        && request.resource.data.tipo in ['image/jpeg','application/pdf']
        && (!exists(/databases/$(database)/documents/contribuicoes/$(id))
            || get(/databases/$(database)/documents/contribuicoes/$(id)).data.status != 'confirmado'));
      allow delete: if can('contribuicoes');
    }

    // Prestação de contas: gastos e comprovantes. Só são lidos por todos depois que os administradores disponibilizam (config/prestacao.publicada)
    match /gastos/{id} {
      allow read: if can('contribuicoes') || (exists(/databases/$(database)/documents/config/prestacao)
        && get(/databases/$(database)/documents/config/prestacao).data.get('publicada', false) == true);
      allow create, update, delete: if can('contribuicoes');
    }
    match /gastosArq/{id} {
      allow read: if can('contribuicoes') || (exists(/databases/$(database)/documents/config/prestacao)
        && get(/databases/$(database)/documents/config/prestacao).data.get('publicada', false) == true);
      allow create, update, delete: if can('contribuicoes');
    }

    // Registro de atividades (imutável): cada usuário grava e lê os próprios registros; admins com permissão "logs" leem todos
    match /logs/{id} {
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['acao','detalhe','usuarioId','usuarioNome','usuarioEmail','alvoNome','criadoEm'])
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && request.resource.data.acao is string && request.resource.data.acao.size() <= 40
        && request.resource.data.detalhe is string && request.resource.data.detalhe.size() <= 400
        && request.resource.data.usuarioNome is string && request.resource.data.usuarioNome.size() <= 160
        && request.resource.data.usuarioEmail is string && request.resource.data.usuarioEmail.size() <= 200
        && request.resource.data.alvoNome is string && request.resource.data.alvoNome.size() <= 160;
      allow read: if can('logs') || (signed() && resource.data.usuarioId == request.auth.uid);
      allow update, delete: if false;
    }

    // Pedidos de acesso enviados por quem não recebeu convite (qualquer pessoa pode enviar; só admins leem)
    match /solicitacoes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome','email','area','lotacao','fone','mensagem','status','criadoEm'])
        && request.resource.data.status == 'pendente'
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 160
        && request.resource.data.area is string && request.resource.data.area.size() > 0 && request.resource.data.area.size() <= 120
        && request.resource.data.lotacao is string && request.resource.data.lotacao.size() <= 120
        && request.resource.data.fone is string && request.resource.data.fone.size() <= 30
        && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 800;
      allow read, update, delete: if can('convites');
    }

    // Servidores
    match /servidores/{uid} {
      allow read: if isStaff() || (signed() && request.auth.uid == uid);
      allow create: if can('servidores') || (isStaff() && request.auth.uid == uid) || (signed() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/convites/$(request.resource.data.convite))
        && (get(/databases/$(database)/documents/convites/$(request.resource.data.convite)).data.multi == true
            || get(/databases/$(database)/documents/convites/$(request.resource.data.convite)).data.usado == false));
      allow update: if can('servidores') || (signed() && request.auth.uid == uid
        && request.resource.data.convite == resource.data.convite);
      allow delete: if can('servidores');
    }

    // Convites: o link (id aleatório) permite ler só aquele convite
    match /convites/{id} {
      allow get: if true;
      allow list: if isStaff();
      allow create, delete: if can('convites');
      allow update: if can('convites') || (signed()
        && resource.data.usado == false
        && request.resource.data.usado == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado','usadoPor','usadoEm']));
    }
  }
}
